# Database Configuration
DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/loan_sales_crm

# JWT Security
SECRET_KEY=your-secure-jwt-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Storage
UPLOAD_DIR=storage/documents
MAX_FILE_SIZE_MB=10

# Environment
ENVIRONMENT=development
DEBUG=True
