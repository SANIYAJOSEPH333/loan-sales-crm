# Virtual Environments & Python Cache
venv/
**/venv/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/

# Node Dependencies & Build Output
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Files & Secrets (exclude all .env except .env.example)
.env
*.env
**/.env
**/.env.*
!**/.env.example

# Database Files
*.db
*.sqlite
*.sqlite3

# Uploaded Customer Documents & Local File Storage
storage/documents/*
!storage/documents/.gitkeep
backend/storage/documents/*
!backend/storage/documents/.gitkeep

# Logs & Temporary Files
*.log
**/*.log

# IDE & OS Metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
